<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- Vehicle: odometer -->
    <uses-permission android:name="pleos.car.permission.CAR_MILEAGE" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- NaviHelper: current address -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- FusedLocation: parking position for the map link (runtime permission) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- TextToSpeech / SpeechToText (on-device) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep recording while navigation is in front, and prompt when parked -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AAOS GEAR_SELECTION -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <queries>
        <package android:name="ai.pleos.playground.service.navi" />
        <intent>
            <action android:name="android.intent.action.CREATE_DOCUMENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="text/csv" />
        </intent>
    </queries>

    <application
        android:label="도착노트"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <!-- While driving, MainActivity shows only DrivingScreen. Review it against Pleos DO rules before release. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Records trip start/end from vehicle gear and odometer signals while another app is displayed" />
        </service>
    </application>
</manifest>
